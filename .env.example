# Copy to .env (git-ignored). Never put real secrets or machine/LAN addresses in source control.
# SUDOKU_API_HOST=127.0.0.1        # use 0.0.0.0 to reach the API from a phone on your network
# SUDOKU_API_PORT=8000
# SUDOKU_API_DB=                   # default: <SUDOKU_DATA_DIR>/api.sqlite3
# SUDOKU_CORS_ORIGINS=             # comma-separated extra origins (browser/Expo-web only)
# OLLAMA_HOST=http://localhost:11434
# SUDOKU_STEP_DELAY=0              # seconds to sleep between search chunks (demo/pacing)
