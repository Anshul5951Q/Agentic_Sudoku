# Copy to .env (git-ignored). Variables prefixed EXPO_PUBLIC_ are embedded in the app bundle at build time.
# Leave unset in development: the app derives the API host from the Expo dev server (works for a physical phone)
# and falls back to the Android emulator's host alias.
# EXPO_PUBLIC_API_BASE_URL=http://<your-computer-LAN-address>:8000
# EXPO_PUBLIC_API_PORT=8000
